{
  "name": "chat-demo-vue",
  "version": "0.1.0",
  "description": "DeepSeek chat-demo@0.1.1 Vue3 重构版本",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run type && vite build",
    "preview": "vite build && vite preview",
    "preview:dist": "vite preview",
    "type": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --cache --max-warnings=0",
    "lint:fix": "eslint . --cache --fix",
    "docs:fields": "node scripts/check-field-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "katex": "^0.18.11",
    "mermaid": "^12.3.0",
    "naive-ui": "^2.45.3",
    "pinia": "^4.1.0",
    "prismjs": "^1.30.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "browserslist": "^4.29.6",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.4.11",
    "eslint-plugin-vue": "^10.12.1",
    "fake-indexeddb": "^6.2.8",
    "lightningcss": "^1.33.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
